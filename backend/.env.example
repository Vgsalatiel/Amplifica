# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

NODE_ENV=development
PORT=3000

# Origem autorizada pelo CORS (endereço do frontend)
CORS_ORIGIN=http://localhost:5173

# Neon: conexão COM pooler (o host contém "-pooler"). Usada pela aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=verify-full&connect_timeout=15"

# Neon: conexão direta (mesmo host, sem "-pooler"). Usada só pelo Prisma CLI nas migrations.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/BANCO?sslmode=verify-full&connect_timeout=15"

# Segredo que assina os tokens de acesso. Gere um valor próprio com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Usados apenas por `npm run seed:admin`, para criar o primeiro administrador.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
