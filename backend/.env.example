# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

NODE_ENV=development
PORT=3000

# Origem autorizada pelo CORS (endereço do frontend)
CORS_ORIGIN=http://localhost:5173

# Neon: conexão COM pooler (o host contém "-pooler"). Usada pela aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=verify-full&connect_timeout=15"

# Neon: conexão direta (mesmo host, sem "-pooler"). Usada só pelo Prisma CLI nas migrations.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/BANCO?sslmode=verify-full&connect_timeout=15"

# Segredo que assina os tokens de acesso. Gere um valor próprio com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Usados apenas por `npm run seed:admin`, para criar o primeiro administrador.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Imagens (capas, fotos de artistas, avatares) em armazenamento compatível com S3,
# como o Cloudflare R2. Deixe tudo vazio em desenvolvimento: as imagens vão para a
# pasta backend/storage. Em produção, sem estas variáveis os uploads são recusados.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# E-mails de confirmação de conta e de redefinição de senha, enviados pelo Resend
# (resend.com). Deixe vazio em desenvolvimento: os links aparecem no terminal da API.
# Em produção, sem estas duas variáveis a confirmação de e-mail não é exigida e
# "esqueci a senha" fica indisponível. O domínio do remetente precisa estar verificado no Resend.
RESEND_API_KEY=
MAIL_FROM=
