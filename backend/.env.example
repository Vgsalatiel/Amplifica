# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

NODE_ENV=development
PORT=3000

# Origem autorizada pelo CORS (endereço do frontend)
CORS_ORIGIN=http://localhost:5173

# Neon: conexão COM pooler (o host contém "-pooler"). Usada pela aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require&connect_timeout=15"

# Neon: conexão direta (mesmo host, sem "-pooler"). Usada só pelo Prisma CLI nas migrations.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/BANCO?sslmode=require&connect_timeout=15"
