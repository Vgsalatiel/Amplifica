// Schema do banco do Amplifica.
// As tabelas entram nas etapas que as utilizam (resenhas na etapa 6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  // Cuida do que a comunidade produz (clipes, comentários, denúncias); não mexe no catálogo.
  MODERATOR
  ADMIN
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  // Sempre gravado em minúsculas, para que a unicidade não dependa de maiúsculas.
  email           String    @unique
  // Letras minúsculas, números, ponto e sublinhado. É o que aparece em /u/<username>.
  username        String    @unique
  // Hash scrypt gerado pelo PasswordHasher. Nunca sai em respostas da API.
  passwordHash    String
  displayName     String
  bio             String?
  // Caminho do avatar no armazenamento de arquivos. A URL pública é montada pela API.
  avatarPath      String?
  role            Role      @default(USER)
  // Preenchido quando a pessoa prova que lê esse e-mail (link de confirmação ou redefinição de senha).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews        Review[]
  emailTokens    EmailToken[]
  clips          Clip[]
  attendances    ShowAttendance[]
  comments       ShowComment[]
  commentReports CommentReport[]
  groupLinks     ShowGroup[]
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Links enviados por e-mail (confirmar o e-mail, redefinir a senha). Uso único e com prazo.
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  // SHA-256 do token. O token em si só existe no e-mail enviado.
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Tokens de renovação de sessão. O formato segue o contrato RefreshTokenStore
// do @nestjs/authentication.
model RefreshToken {
  // SHA-256 do token. O token em si nunca é gravado.
  id              String    @id
  // Toda rotação continua na "família" do login original.
  familyId        String
  // Sem chave estrangeira: o contrato trata o id do usuário como texto opaco.
  // A limpeza ao excluir um usuário é feita pelo service.
  userId          String
  createdAt       DateTime
  expiresAt       DateTime
  familyExpiresAt DateTime
  // Preenchido quando o token é trocado por um novo. Reapresentar um token usado indica roubo.
  usedAt          DateTime?
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
}

// Famílias revogadas (logout ou reuso detectado). Fica em tabela própria porque a
// revogação precisa valer também para tokens da família gravados depois dela.
model RevokedTokenFamily {
  familyId  String   @id
  revokedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

enum ArtistType {
  BAND
  SOLO
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  LIVE
  COMPILATION
}

// Muitos lançamentos só têm ano ou mês conhecidos. A precisão evita inventar dia e mês.
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

enum ReleaseArtistRole {
  PRIMARY
  FEATURED
}

// Gêneros formam uma árvore: um subgênero é um gênero com `parentId`.
model Genre {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: um gênero com subgêneros não pode ser excluído.
  parent   Genre?        @relation("GenreTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Genre[]       @relation("GenreTree")
  artists  ArtistGenre[]
  shows    ShowGenre[]

  @@index([parentId])
}

model Artist {
  id            String     @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String     @unique
  type          ArtistType @default(BAND)
  bio           String?
  // Código ISO 3166-1 de duas letras, como "BR".
  country       String?
  city          String?
  formedYear    Int?
  disbandedYear Int?
  imagePath     String?
  // Fontes do texto da bio, como [{ name, url }]. Exibidas na página do artista.
  sources       Json?
  // Identificador no MusicBrainz, para a importação futura.
  mbid          String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  genres   ArtistGenre[]
  releases ReleaseArtist[]
  shows    ShowAct[]
  clips    Clip[]

  @@index([name])
}

model ArtistGenre {
  artistId String @db.Uuid
  genreId  String @db.Uuid

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  // Restrict: um gênero em uso por artistas não pode ser excluído.
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([artistId, genreId])
  @@index([genreId])
}

// Um lançamento é a obra (álbum, EP, single), não cada edição ou prensagem dela.
model Release {
  id             String        @id @default(uuid(7)) @db.Uuid
  title          String
  slug           String        @unique
  type           ReleaseType
  releaseDate    DateTime      @db.Date
  datePrecision  DatePrecision @default(DAY)
  description    String?
  coverPath      String?
  // Cor de destaque da página do álbum, em #RRGGBB. Extraída da capa ou definida pelo admin.
  accentColor    String?
  youtubeVideoId String?
  mbid           String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  artists ReleaseArtist[]
  tracks  Track[]
  reviews Review[]

  @@index([releaseDate])
}

// Artista e lançamento em N:N: cobre splits e participações.
model ReleaseArtist {
  releaseId String            @db.Uuid
  artistId  String            @db.Uuid
  role      ReleaseArtistRole @default(PRIMARY)
  // Ordem em que os artistas aparecem no lançamento.
  position  Int               @default(0)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  // Restrict: um artista com lançamentos não pode ser excluído.
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([releaseId, artistId])
  @@index([artistId])
}

model Track {
  id         String @id @default(uuid(7)) @db.Uuid
  releaseId  String @db.Uuid
  title      String
  discNumber Int    @default(1)
  position   Int
  durationMs Int?

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, discNumber, position])
}

// ---------------------------------------------------------------------------
// Avaliações
// ---------------------------------------------------------------------------

// Uma avaliação por pessoa e por disco: avaliar de novo substitui a anterior.
model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  releaseId String   @db.Uuid
  // Nota de 1 a 10. A API valida, e uma regra CHECK na migration garante no banco.
  rating    Int
  // Texto simples, opcional. Sem texto, a avaliação conta na média mas não aparece na lista de resenhas.
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: apagar a conta ou o disco leva as avaliações junto.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  // Lista de resenhas de um disco, da mais recente para a mais antiga.
  @@index([releaseId, createdAt])
  // Avaliações de uma pessoa, na página do perfil dela.
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Shows
// ---------------------------------------------------------------------------

enum ShowStatus {
  CONFIRMED
  SOLD_OUT
  CANCELLED
}

// Um show (ou festival) no Brasil. A escalação fica em ShowAct, para cobrir eventos com várias bandas.
model Show {
  id            String     @id @default(uuid(7)) @db.Uuid
  // Nome do evento, quando existe (festival, turnê). Show comum não precisa.
  name          String?
  slug          String     @unique
  // Dia do show, sem horário: a data de calendário no Brasil.
  date          DateTime   @db.Date
  // Horário de início, como "20:00". Opcional: nem todo anúncio traz.
  startTime     String?
  venue         String
  city          String
  // Sigla do estado, como "SP". Uma regra CHECK na migration garante o formato.
  state         String
  // Link do vendedor ou da página oficial do evento. Só http e https.
  ticketUrl     String?
  // Quem organiza o evento (produtora, página de divulgação) e o link dela, quando existe.
  organizerName String?
  organizerUrl  String?
  // Pôster de divulgação enviado pelo admin (caminho base da imagem no armazenamento).
  posterPath    String?
  status        ShowStatus @default(CONFIRMED)
  // Quando alguém conferiu esta informação pela última vez. Aparece na página.
  verifiedAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  acts        ShowAct[]
  genres      ShowGenre[]
  attendances ShowAttendance[]
  comments    ShowComment[]
  groups      ShowGroup[]

  // Agenda: próximos shows, com ou sem filtro de estado.
  @@index([date])
  @@index([state, date])
}

// Uma atração da escalação. Com `artistId`, liga à página da banda no catálogo;
// sem ele (banda fora do catálogo), só o nome aparece.
model ShowAct {
  id       String  @id @default(uuid(7)) @db.Uuid
  showId   String  @db.Uuid
  // Ordem na escalação; a primeira é a atração principal.
  position Int
  name     String
  artistId String? @db.Uuid

  show   Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  // SetNull: apagar a banda do catálogo não apaga o show, só desfaz o link.
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@unique([showId, position])
  @@index([artistId])
}

// Gêneros do show. Próprios do show (e não herdados do artista) para valer também para bandas de fora do catálogo.
model ShowGenre {
  showId  String @db.Uuid
  genreId String @db.Uuid

  show  Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  // Restrict: um gênero em uso por shows não pode ser excluído.
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([showId, genreId])
  @@index([genreId])
}

enum ClipStatus {
  PENDING
  APPROVED
  REJECTED
}

// Clipe da playlist "Agora na tela", na página inicial. Os fixos abrem a playlist; os demais são
// sugestões de quem tem conta e só aparecem depois de aprovados por um administrador.
model Clip {
  id            String     @id @default(uuid(7)) @db.Uuid
  // Código do vídeo no YouTube (11 caracteres; uma regra CHECK na migration garante o formato).
  // Único: o mesmo vídeo não entra duas vezes, nem como sugestão repetida.
  youtubeId     String     @unique
  // Título e canal vêm do YouTube no momento da sugestão.
  title         String
  channelName   String
  // Banda do catálogo à qual o clipe pertence, quando alguém a ligou (administrador).
  artistId      String?    @db.Uuid
  // Clipes fixos tocam antes das sugestões, na ordem de `position`.
  pinned        Boolean    @default(false)
  position      Int        @default(0)
  status        ClipStatus @default(PENDING)
  // Quem sugeriu. Se a conta for apagada, o clipe fica sem autor em vez de sumir.
  submittedById String?    @db.Uuid
  createdAt     DateTime   @default(now())
  reviewedAt    DateTime?

  artist      Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  submittedBy User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  // Playlist pública: aprovados, fixos primeiro.
  @@index([status, pinned, createdAt])
  // Limite diário de sugestões por pessoa.
  @@index([submittedById, createdAt])
}

// "Eu vou": a presença de uma pessoa num show. O nome só aparece na lista pública se ela marcou showName.
model ShowAttendance {
  userId    String   @db.Uuid
  showId    String   @db.Uuid
  showName  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([showId, createdAt])
}

// Mural do show: comentários simples, sem respostas. Quem escreve ou um moderador pode apagar.
model ShowComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  showId    String   @db.Uuid
  userId    String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  show    Show            @relation(fields: [showId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports CommentReport[]

  @@index([showId, createdAt])
}

// Denúncia de um comentário. Uma por pessoa e comentário; `resolvedAt` marca as que um moderador já viu.
model CommentReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  commentId  String    @db.Uuid
  reporterId String    @db.Uuid
  reason     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  comment  ShowComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([resolvedAt, createdAt])
}

enum GroupPlatform {
  WHATSAPP
  TELEGRAM
  DISCORD
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
}

// Link de um grupo externo (WhatsApp, Telegram ou Discord) para quem vai a um show. Qualquer conta
// verificada sugere; só aparece na página depois que um moderador aprova.
model ShowGroup {
  id            String        @id @default(uuid(7)) @db.Uuid
  showId        String        @db.Uuid
  platform      GroupPlatform
  url           String
  status        GroupStatus   @default(PENDING)
  submittedById String?       @db.Uuid
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  show        Show  @relation(fields: [showId], references: [id], onDelete: Cascade)
  submittedBy User? @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@unique([showId, url])
  @@index([showId, status])
  @@index([status, createdAt])
  @@index([submittedById, createdAt])
}
