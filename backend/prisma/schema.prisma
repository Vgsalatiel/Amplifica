// Schema do banco do Amplifica.
// As tabelas entram nas etapas que as utilizam (resenhas na etapa 6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Sempre gravado em minúsculas, para que a unicidade não dependa de maiúsculas.
  email        String   @unique
  // Letras minúsculas, números, ponto e sublinhado. É o que aparece em /u/<username>.
  username     String   @unique
  // Hash scrypt gerado pelo PasswordHasher. Nunca sai em respostas da API.
  passwordHash String
  displayName  String
  bio          String?
  // Caminho do avatar no armazenamento de arquivos. A URL pública é montada pela API.
  avatarPath   String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews Review[]
}

// Tokens de renovação de sessão. O formato segue o contrato RefreshTokenStore
// do @nestjs/authentication.
model RefreshToken {
  // SHA-256 do token. O token em si nunca é gravado.
  id              String    @id
  // Toda rotação continua na "família" do login original.
  familyId        String
  // Sem chave estrangeira: o contrato trata o id do usuário como texto opaco.
  // A limpeza ao excluir um usuário é feita pelo service.
  userId          String
  createdAt       DateTime
  expiresAt       DateTime
  familyExpiresAt DateTime
  // Preenchido quando o token é trocado por um novo. Reapresentar um token usado indica roubo.
  usedAt          DateTime?
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
}

// Famílias revogadas (logout ou reuso detectado). Fica em tabela própria porque a
// revogação precisa valer também para tokens da família gravados depois dela.
model RevokedTokenFamily {
  familyId  String   @id
  revokedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

enum ArtistType {
  BAND
  SOLO
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  LIVE
  COMPILATION
}

// Muitos lançamentos só têm ano ou mês conhecidos. A precisão evita inventar dia e mês.
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

enum ReleaseArtistRole {
  PRIMARY
  FEATURED
}

// Gêneros formam uma árvore: um subgênero é um gênero com `parentId`.
model Genre {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: um gênero com subgêneros não pode ser excluído.
  parent   Genre?        @relation("GenreTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Genre[]       @relation("GenreTree")
  artists  ArtistGenre[]

  @@index([parentId])
}

model Artist {
  id            String     @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String     @unique
  type          ArtistType @default(BAND)
  bio           String?
  // Código ISO 3166-1 de duas letras, como "BR".
  country       String?
  city          String?
  formedYear    Int?
  disbandedYear Int?
  imagePath     String?
  // Fontes do texto da bio, como [{ name, url }]. Exibidas na página do artista.
  sources       Json?
  // Identificador no MusicBrainz, para a importação futura.
  mbid          String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  genres   ArtistGenre[]
  releases ReleaseArtist[]

  @@index([name])
}

model ArtistGenre {
  artistId String @db.Uuid
  genreId  String @db.Uuid

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  // Restrict: um gênero em uso por artistas não pode ser excluído.
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([artistId, genreId])
  @@index([genreId])
}

// Um lançamento é a obra (álbum, EP, single), não cada edição ou prensagem dela.
model Release {
  id             String        @id @default(uuid(7)) @db.Uuid
  title          String
  slug           String        @unique
  type           ReleaseType
  releaseDate    DateTime      @db.Date
  datePrecision  DatePrecision @default(DAY)
  description    String?
  coverPath      String?
  // Cor de destaque da página do álbum, em #RRGGBB. Extraída da capa ou definida pelo admin.
  accentColor    String?
  youtubeVideoId String?
  mbid           String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  artists ReleaseArtist[]
  tracks  Track[]
  reviews Review[]

  @@index([releaseDate])
}

// Artista e lançamento em N:N: cobre splits e participações.
model ReleaseArtist {
  releaseId String            @db.Uuid
  artistId  String            @db.Uuid
  role      ReleaseArtistRole @default(PRIMARY)
  // Ordem em que os artistas aparecem no lançamento.
  position  Int               @default(0)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  // Restrict: um artista com lançamentos não pode ser excluído.
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([releaseId, artistId])
  @@index([artistId])
}

model Track {
  id         String @id @default(uuid(7)) @db.Uuid
  releaseId  String @db.Uuid
  title      String
  discNumber Int    @default(1)
  position   Int
  durationMs Int?

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, discNumber, position])
}

// ---------------------------------------------------------------------------
// Avaliações
// ---------------------------------------------------------------------------

// Uma avaliação por pessoa e por disco: avaliar de novo substitui a anterior.
model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  releaseId String   @db.Uuid
  // Nota de 1 a 10. A API valida, e uma regra CHECK na migration garante no banco.
  rating    Int
  // Texto simples, opcional. Sem texto, a avaliação conta na média mas não aparece na lista de resenhas.
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: apagar a conta ou o disco leva as avaliações junto.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  // Lista de resenhas de um disco, da mais recente para a mais antiga.
  @@index([releaseId, createdAt])
  // Avaliações de uma pessoa, na página do perfil dela.
  @@index([userId, createdAt])
}
