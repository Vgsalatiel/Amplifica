# Opcional. Endereço base da API.
# Em desenvolvimento deixe vazio: o Vite encaminha /api para http://localhost:3000.
# Nunca coloque segredos aqui: toda variável VITE_* vai para o código enviado ao navegador.
VITE_API_URL=

# Opcional. Endereço (DSN) do projeto no Sentry para ser avisado de erros no site. Sem ele, nada é enviado.
# O DSN é público por natureza (vai para o navegador), mas só vale para enviar erros ao seu projeto.
VITE_SENTRY_DSN=
